

# Consultar un elemento
numeros = [10, 20, 30, 40, 50]
print(numeros[2])

# Modificar un elemento
numeros = [10, 20, 30, 40, 50]
numeros[2] = 99
print(numeros)

# Agregar un elemento
numeros = [10, 20, 30, 40, 50]
numeros.append(60)
print(numeros)

# Opción 1 con append
numeros = [10, 20, 30, 40, 50]
numeros.append(60)
numeros.append(70)
print(numeros)

# Opción 2 con append
numeros = [10, 20, 30, 40, 50]
numeros.append([60, 70])
print(numeros)

# Imprimir el 60
numeros = [10, 20, 30, 40, 50, [60, 70]]
print(numeros[5][0])

# Insert()
numeros = [10, 20, 30, 40]
numeros.insert(2, 25)
print(numeros)

# Operador + 
numeros = [10, 20, 30, 40]
numeros = numeros + [50]
print(numeros)

# Operador + 
numeros = [10, 20, 30, 40]
numeros = numeros + [50, 60, 70]
print(numeros)

# extend()
numeros = [10, 20, 30]
numeros[len(numeros):] = [40, 50]
print(numeros)


