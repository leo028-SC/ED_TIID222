#Ejemplo de Cola

from collections import deque
import time

cola = deque()

cola.append("ana")
cola.append("juan")
cola.append("pedro")

print("Cola actual:", list(cola))

time.sleep(2)

atendido = cola.popleft()
print("Se atendió a:", atendido)

time.sleep(2)

print("siguiente en la cola:", cola[0])

time.sleep(3)

print ("Cola restante:", list(cola))